# ========================================================
# Production Runtime Image for Pre-Packaged / Tested WAR
# ========================================================
FROM eclipse-temurin:17-jre

ARG VERSION=1.0.0
ARG COMMIT_SHA=""
ARG BUILD_NUMBER=""

LABEL maintainer="Ganesh Dahiphale" \
      org.opencontainers.image.title="Construction Progress Dashboard" \
      org.opencontainers.image.description="Spring Boot 3 Construction Project Progress Dashboard Web Application" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT_SHA}" \
      org.opencontainers.image.build="${BUILD_NUMBER}" \
      org.opencontainers.image.source="https://github.com/ganesh-dahiphale/construction_project_dashboard"

# Create dedicated non-root user, group, and persistent data directory
RUN groupadd -r appgroup && \
    useradd -r -g appgroup -d /app -s /sbin/nologin appuser && \
    mkdir -p /app/data && \
    chown -R appuser:appgroup /app

WORKDIR /app

# Copy the pre-built, tested WAR archive directly from target directory
COPY --chown=appuser:appgroup target/dashboard.war /app/app.war

# Set directory permissions
RUN chown -R appuser:appgroup /app

# Declare persistent storage volume for file-based H2 database
VOLUME ["/app/data"]

# Switch to non-root execution user
USER appuser

# Expose standard application HTTP port
EXPOSE 8080

# Environment variables with persistent file-based H2 default
ENV JAVA_OPTS="" \
    SERVER_PORT=8080 \
    APP_VERSION=dev \
    DB_URL="jdbc:h2:file:/app/data/dashboard;AUTO_SERVER=false"

# Container healthcheck against /health endpoint using built-in curl
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -f http://localhost:${SERVER_PORT}/health || exit 1

# Launch executable WAR with Java
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.war"]
