[Unit]
Description=Construction Progress Dashboard Container Service
After=docker.service
Requires=docker.service

[Service]
Type=simple
User={{ app_user }}
Group={{ app_group }}
Restart=unless-stopped
RestartSec=10s
TimeoutStartSec=120
TimeoutStopSec=30
EnvironmentFile={{ app_dir }}/config/app.env
ExecStartPre=-/usr/bin/docker stop {{ container_name }}
ExecStartPre=-/usr/bin/docker rm {{ container_name }}
ExecStart=/usr/bin/docker run --name {{ container_name }} \
  --rm \
  -p {{ app_port }}:8080 \
  --env-file {{ app_dir }}/config/app.env \
  {{ docker_image }}:{{ image_tag }}
ExecStop=/usr/bin/docker stop -t 15 {{ container_name }}

[Install]
WantedBy=multi-user.target
